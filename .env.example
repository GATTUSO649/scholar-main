# PostgreSQL connection string for Supabase or any Postgres-compatible database.
DATABASE_URL=postgres://postgres:your-password@db-project.supabase.co:5432/postgres
# Optional migration-only connection string if you keep a separate admin account.
DATABASE_MIGRATION_URL=
# Temporary, migration-only source connection. Never configure this on Render.
MYSQL_SOURCE_URL=

# Optional split-variable fallback if you are not using a full connection string.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

APP_URL=http://localhost:8080
FILE_STORAGE_DIR=./data/uploads
REQUEST_MAX_FILE_BYTES=20971520
REQUEST_MAX_TOTAL_BYTES=52428800
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_MAX_TOTAL_BYTES=52428800

# Optional: enables admin signup. Use a private random value of 32+ characters.
ADMIN_SIGNUP_SECRET=

# Required for transactional email delivery
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
EMAIL_FROM=ScholarDesk <no-reply@example.com>
EMAIL_FROM_NAME=ScholarDesk
API_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false

# Safaricom Daraja production M-PESA Till configuration. Keep secrets server-side.
MPESA_ENV=production
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS callback endpoint: https://your-domain/api/library/callback
MPESA_CALLBACK_URL=
MPESA_STK_QUERY_ENABLED=true
