# Local development default. In Railway, set MYSQL_URL using Add Reference on the MySQL service.
MYSQL_URL=mysql://root@127.0.0.1:3306/scholar_desk
# Optional split-variable fallback; MYSQL_URL takes precedence when set.
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=
MYSQLDATABASE=
MYSQLHOST=
MYSQLPASSWORD=
MYSQLPORT=
MYSQLUSER=
# Optional full mysql:// URL for a DDL-privileged migration account. Otherwise MYSQL_URL is used.
MYSQL_MIGRATION_URL=
APP_URL=http://localhost:8080
FILE_STORAGE_DIR=./data/uploads

# Optional: enables admin signup. Use a private random value of 32+ characters.
ADMIN_SIGNUP_SECRET=

# Required for transactional email delivery
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
EMAIL_FROM=ScholarDesk <no-reply@example.com>
EMAIL_FROM_NAME=ScholarDesk
APP_URL=http://localhost:8080
API_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false

# Optional: Safaricom Daraja M-Pesa STK Push. Keep credentials server-side.
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS callback endpoint: https://your-domain/api/library/callback
MPESA_CALLBACK_URL=
